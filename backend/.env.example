# Passive Liveness Detection API - Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to git (it's in .gitignore)

# ===== SERVER CONFIGURATION =====
# Port for FastAPI server (Render uses 10000)
PORT=10000

# ===== MODEL CONFIGURATION =====
# Model file path (relative to backend directory)
MODEL_PATH=model.pth

# Device: 'cpu' for cloud, 'cuda' for GPU
DEVICE=cpu

# ===== AI EXPLANATION API (Optional) =====
# Google Gemini API Key for AI explanations
# Get from: https://makersuite.google.com/app/apikey
# Leave empty to disable AI explanations (section won't appear in frontend)
GEMINI_API_KEY=

# ===== SECURITY & CORS =====
# CORS allowed origins (comma-separated, "*" for all origins)
# Production: Change to your frontend domain
CORS_ORIGINS=*

# ===== LOGGING =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===== IMAGE PROCESSING =====
# Max image size in bytes (10MB default)
MAX_IMAGE_SIZE=10485760

# Min image size in bytes (10KB default)  
MIN_IMAGE_SIZE=10240

# Allowed image formats
ALLOWED_FORMATS=jpg,jpeg,png
